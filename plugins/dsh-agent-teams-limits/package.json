{
  "name": "dsh-agent-teams-limits",
  "version": "0.1.0",
  "description": "DSH plugin: Settings → Plugins card for AgentTeams member cap and per-team concurrency cap.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1 <0.2.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "limits",
    "concurrency",
    "settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mimajiushi/dsh-plugins.git"
  },
  "homepage": "https://github.com/mimajiushi/dsh-plugins/tree/main/plugins/dsh-agent-teams-limits#readme",
  "author": "mimajiushi",
  "license": "MIT"
}
